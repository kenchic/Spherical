@using MudBlazor
@using Creative.Modelos.Lineup
@using Spherical.Client.Services
@using Spherical.Client.DTO.Common
@using System.Security.Claims
@namespace Spherical.Blazor.Components

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Datos del Cliente</MudText>
                <MudDivider Class="mb-3" />
                <MudSelect T="int"
                    Label="Cliente" 
                    Value="SelectedClienteId"
                    ValueChanged="OnClienteSeleccionado"
                    For="@(() => SelectedClienteId)"
                    Clearable>
                        @if (Clientes != null)
                        {
                            foreach (var c in Clientes)
                            {
                                <MudSelectItem Value="@c.Id">@c.Nombre (@c.Identificacion)</MudSelectItem>
                            }
                        }
                </MudSelect>
                @if (SelectedClienteId == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">O cree un nuevo cliente:</MudAlert>
                }
                <SphFormularioCliente @ref="_clienteForm" Cliente="NuevoCliente" OnSaved="OnClienteCreado" MostrarBotonGuardar="(SelectedClienteId == 0)" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Nuevo Proyecto</MudText>
                <MudDivider Class="mb-3" />
                <MudForm @ref="_projectForm" Model="Proyecto" OnValidSubmit="OnSubmitProyecto">
                    <MudTextField @bind-Value="Proyecto.Nombre" Label="Nombre del Proyecto" Required="true" />
                    <MudTextField @bind-Value="Proyecto.Tipo" Label="Tipo de Proyecto" Required="true" />
                    <SphListaCatalogo @bind-SelectedId="Proyecto.IdCiudad" Etiqueta="Ciudad" IdCatalogo="CIUDAD" OnCreated="OnCrearCiudad" />
                    <MudTextField @bind-Value="Proyecto.Direccion" Label="Dirección" />
                    <MudTextField @bind-Value="Proyecto.Telefono" Label="Teléfono" />
                    <MudSelect T="string" Label="Forma de Solicitud" @bind-Value="Proyecto.FormaContacto" For="@(() => Proyecto.FormaContacto)">
                        <MudSelectItem Value="@("TEL")">Teléfono</MudSelectItem>
                        <MudSelectItem Value="@("CEL")">Celular</MudSelectItem>
                        <MudSelectItem Value="@("COR")">Correo</MudSelectItem>
                        <MudSelectItem Value="@("WEB")">Web</MudSelectItem>
                        <MudSelectItem Value="@("PER")">Personal</MudSelectItem>
                    </MudSelect>
                    <SphListaCatalogo @bind-SelectedId="Proyecto.SistemaMedida" Etiqueta="Unidad de Medida" IdCatalogo="UN_ELEMENTO" OnCreated="OnCrearCiudad" />
                    <MudTextField @bind-Value="Proyecto.Observacion" Label="Observaciones" Lines="3" />
                    <MudStack Row Class="mt-2" Spacing="2">
                        <MudSwitch @bind-Value="Proyecto.Activo" Color="Color.Primary" Label="Activo" />
                        <MudSpacer />
                        @if (MostrarBotonGuardar)
                        {
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Type="Button" OnClick="SubmitProyecto" Disabled="LoadingProyecto || SavingAll" Loading="LoadingProyecto || SavingAll">Guardar Proyecto</MudButton>
                            
                        }
                        <MudButton Class="ml-2" Color="Color.Secondary" Variant="Variant.Filled" Type="Button" OnClick="GuardarTodo" Disabled="SavingAll" Loading="SavingAll">Guardar Cliente + Proyecto</MudButton>
                    </MudStack>
                    @if (!string.IsNullOrEmpty(ProjectError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@ProjectError</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(ProjectSuccess))
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">@ProjectSuccess</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(AllError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@AllError</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(AllSuccess))
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">@AllSuccess</MudAlert>
                    }
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

    [Parameter] public bool MostrarBotonGuardar { get; set; } = false;
    [Inject] public IClientService ClientService { get; set; } = default!;
    [Inject] public IProjectService ProjectService { get; set; } = default!;
    [Inject] public AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private IEnumerable<VClienteModeloDto>? Clientes;
    private int SelectedClienteId;
    private ClienteModeloDto NuevoCliente = new() { Activo = true };

    private ProyectoModeloDto Proyecto = new()
    {
        Activo = true,
        Fecha = DateTime.Today,
        Estado = "D"
    };

    private MudForm _projectForm = default!;
    private SphFormularioCliente _clienteForm = default!;
    private bool LoadingProyecto;
    private bool SavingAll;
    private string ProjectError = string.Empty;
    private string ProjectSuccess = string.Empty;
    private string AllError = string.Empty;
    private string AllSuccess = string.Empty;
    private string Empresa = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        string tokenApp = (AuthStateProvider as CustomAuthStateProvider)?.GetToken();
        ProjectService.SetAuth(tokenApp);
        ClientService.SetAuth(tokenApp);

        var resp = await ClientService.GetClientesAsync();
        Clientes = resp.Data ?? Enumerable.Empty<VClienteModeloDto>();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Extraer name y locale desde los claims (con fallback)
        Empresa = GetClaim(user, "locale", ClaimTypes.Locality, "ui_locale") ?? "AYZCORP";
    }

    private async Task OnClienteCreado(ClienteModeloDto cliente)
    {
        var v = new VClienteModeloDto
        {
            Id = cliente.Id,
            idCiudad = cliente.IdCiudad,
            CiudadNombre = cliente.IdCiudad,
            Identificacion = cliente.Identificacion,
            Nombre1 = cliente.Nombre1,
            Apellido1 = cliente.Apellido1,
            Nombre = cliente.Nombre1 + " " + cliente.Apellido1,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Celular = cliente.Celular ?? string.Empty,
            Correo = cliente.Correo ?? string.Empty,
            Activo = cliente.Activo
        };
        Clientes = (Clientes ?? Enumerable.Empty<VClienteModeloDto>()).Concat(new[] { v });
        SelectedClienteId = cliente.Id;
    }

    private void OnClienteSeleccionado(int clienteId)
    {
        SelectedClienteId = clienteId;

        if (clienteId == 0)
        {
            // Deseleccionado: limpiar formulario para nuevo cliente
            NuevoCliente = new ClienteModeloDto { Activo = true };
            _clienteForm?.CargarCliente(NuevoCliente);
            return;
        }

        var clienteVista = Clientes?.FirstOrDefault(c => c.Id == clienteId);
        if (clienteVista == null) return;

        var clienteDto = new ClienteModeloDto
        {
            Id = clienteVista.Id,
            IdCiudad = clienteVista.idCiudad ?? string.Empty,
            Identificacion = clienteVista.Identificacion ?? string.Empty,
            Nombre1 = clienteVista.Nombre1 ?? string.Empty,
            Apellido1 = clienteVista.Apellido1 ?? string.Empty,
            Direccion = clienteVista.Direccion ?? string.Empty,
            Telefono = clienteVista.Telefono ?? string.Empty,
            Celular = clienteVista.Celular ?? string.Empty,
            Correo = clienteVista.Correo ?? string.Empty,
            Activo = clienteVista.Activo
        };

        NuevoCliente = clienteDto;
        _clienteForm?.CargarCliente(clienteDto);
    }

    private async Task<bool> SaveProyectoAsync()
    {
        LoadingProyecto = true;
        ProjectError = string.Empty;
        ProjectSuccess = string.Empty;
        await _projectForm.Validate();
        if (!_projectForm.IsValid)
        {
            LoadingProyecto = false;
            ProjectError = "Revise los campos del proyecto";
            return false;
        }

        Proyecto.IdCliente = SelectedClienteId;
        Proyecto.Empresa = Empresa;
        var resp = await ProjectService.CreateProyectoAsync(Proyecto);
        LoadingProyecto = false;
        if (resp.Success && resp.Data != null)
        {
            ProjectSuccess = $"Proyecto #{resp.Data.Id} creado";
            return true;
        }
        else
        {
            ProjectError = resp.ErrorMessage ?? "Error al crear proyecto";
            return false;
        }
    }

    private async Task OnSubmitProyecto()
    {
        await SaveProyectoAsync();
    }

    private Task SubmitProyecto() => OnSubmitProyecto();

    private async Task GuardarTodo()
    {
        AllError = string.Empty;
        AllSuccess = string.Empty;
        SavingAll = true;

        await _projectForm.Validate();
        if (!_projectForm.IsValid)
        {
            SavingAll = false;
            ProjectError = "Revise los campos del proyecto";
            return;
        }

        if (_clienteForm == null)
        {
            SavingAll = false;
            AllError = "Formulario de cliente no disponible";
            return;
        }

        var clienteValido = await _clienteForm.ValidateAndSaveAsync();
        if (!clienteValido)
        {
            SavingAll = false;
            return;
        }

        var proyectoGuardado = await SaveProyectoAsync();
        if (!proyectoGuardado)
        {
            SavingAll = false;
            AllError = "Error al guardar el proyecto";
            return;
        }

        var clienteGuardado = await _clienteForm.ValidateAndSaveAsync();
        if (!clienteGuardado)
        {
            SavingAll = false;
            AllError = "Error al guardar el cliente";
            return;
        }

        SavingAll = false;
        AllSuccess = "Proyecto y cliente guardados";
    }

    private void OnCrearCiudad(CatalogoDetalleModelo detalle)
    {
        Proyecto.IdCiudad = detalle.Id;
    }

    private string? GetClaim(ClaimsPrincipal user, params string[] types)
    {
        foreach (var type in types)
        {
            var claim = user.FindFirst(type);
            if (claim != null && !string.IsNullOrEmpty(claim.Value))
                return claim.Value;
        }
        return null;
    }
}
