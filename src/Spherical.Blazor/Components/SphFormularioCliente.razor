@using MudBlazor
@using Creative.Modelos.Lineup
@using Spherical.Client.Services
@using Spherical.Client.DTO.Common
@namespace Spherical.Blazor.Components

<MudPaper Class="pa-4">
    <MudForm @ref="_form" Model="Cliente" OnValidSubmit="@OnSubmitValid">
        <MudTextField @bind-Value="Cliente.Identificacion" Label="Nit/Cédula" Required="true" RequiredError="Requerido" />
        <MudTextField @bind-Value="Cliente.Nombre1" Label="1er Nombre" Required="true" RequiredError="Requerido" />
        <MudTextField @bind-Value="Cliente.Nombre2" Label="2do Nombre" />
        <MudTextField @bind-Value="Cliente.Apellido1" Label="1er Apellido" />
        <MudTextField @bind-Value="Cliente.Apellido1" Label="2do Apellido" />
        <MudTextField @bind-Value="Cliente.Direccion" Label="Dirección" Required="true" RequiredError="Requerido" />
        <SphListaCatalogo @bind-SelectedId="Cliente.IdCiudad" Etiqueta="Ciudad" IdCatalogo="CIUDAD" OnCreated="OnCrearCiudad" />
        <MudTextField @bind-Value="Cliente.Telefono" Label="Tel./Fax" Required="true" RequiredError="Requerido" />
        <MudTextField @bind-Value="Cliente.Celular" Label="Celular" Required="true" RequiredError="Requerido" />
        <MudTextField @bind-Value="Cliente.Correo" Required="true" Label="Email" RequiredError="Requerido" />
        <MudStack Row Class="mt-2" Spacing="2">
            <MudSwitch @bind-Value="Cliente.Activo" Color="Color.Primary" Label="Activo" />
            <MudSpacer />
            @if (MostrarBotonGuardar)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="Loading" Loading="Loading">Guardar cliente</MudButton>
            }
        </MudStack>
        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@Error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(Success))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">@Success</MudAlert>
        }
    </MudForm>
</MudPaper>

@code {
    [Parameter] public ClienteModeloDto Cliente { get; set; } = new();
    [Parameter] public bool MostrarBotonGuardar { get; set; } = false;
    [Parameter] public EventCallback<ClienteModeloDto> OnSaved { get; set; }

    [Inject] public IClientService ClientService { get; set; } = default!;

    private MudForm _form = default!;
    private bool Loading;
    private string Error = string.Empty;
    private string Success = string.Empty;

    private async Task OnSubmitValid() => await Save();

    private async Task Save()
    {
        Loading = true;
        Error = string.Empty;
        Success = string.Empty;
        await _form.Validate();
        if (!_form.IsValid)
        {
            Loading = false;
            Error = "Revise los campos obligatorios";
            return;
        }
        var resp = await ClientService.CreateClienteAsync(Cliente);
        Loading = false;
        if (resp.Success && resp.Data != null)
        {
            Cliente.Id = resp.Data.Id;
            Success = "Cliente creado";
            await OnSaved.InvokeAsync(Cliente);
        }
        else
        {
            Error = resp.ErrorMessage ?? "Error al crear cliente";
        }
    }

    private async Task Submit() => await OnSubmitValid();

    private void OnCrearCiudad(CatalogoDetalleModelo detalle)
    {
        Cliente.IdCiudad = detalle.Id;
    }
}
