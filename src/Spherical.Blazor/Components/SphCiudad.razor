@using MudBlazor
@using Spherical.Client.Services
@using Spherical.Client.DTO.Common
@namespace Spherical.Blazor.Components

<MudStack Row Spacing="1">
    <MudSelect T="string" Label="Ciudad" @bind-Value="SelectedId" Required="true">
        @if (Ciudades != null)
        {
            foreach (var c in Ciudades)
            {
                <MudSelectItem Value="@c.Id">@c.Nombre</MudSelectItem>
            }
        }
    </MudSelect>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenDialog" />
</MudStack>

<MudDialog @bind-IsVisible="DialogOpen">
    <DialogContent>
        <MudTextField @bind-Value="NuevaCiudadNombre" Label="Nombre de ciudad" />
        <MudTextField @bind-Value="NuevaCiudadId" Label="Código" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CrearCiudad" Disabled="Loading" Loading="Loading">Crear</MudButton>
        <MudButton OnClick="CloseDialog">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string IdCatalogo { get; set; } = "CIUDAD";
    [Parameter] public string SelectedId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }
    [Parameter] public EventCallback<CatalogoDetalleModelo> OnCreated { get; set; }

    [Inject] public ICatalogService CatalogService { get; set; } = default!;

    private IEnumerable<CatalogoDetalleModelo>? Ciudades;
    private bool DialogOpen;
    private string NuevaCiudadNombre = string.Empty;
    private string NuevaCiudadId = string.Empty;
    private bool Loading;

    protected override async Task OnInitializedAsync()
    {
        var resp = await CatalogService.GetDetallesAsync(IdCatalogo);
        Ciudades = resp.Data ?? Enumerable.Empty<CatalogoDetalleModelo>();
        if (string.IsNullOrEmpty(SelectedId) && Ciudades.Any())
            SelectedId = Ciudades.First().Id;
    }

    private void OpenDialog() => DialogOpen = true;
    private void CloseDialog() => DialogOpen = false;

    private async Task CrearCiudad()
    {
        Loading = true;
        var nuevo = new CatalogoDetalleModelo { Id = NuevaCiudadId.Trim(), Nombre = NuevaCiudadNombre.Trim(), Activo = true };
        var resp = await CatalogService.CreateDetalleAsync(IdCatalogo, nuevo);
        Loading = false;
        if (resp.Success && resp.Data != null)
        {
            await OnCreated.InvokeAsync(resp.Data);
            Ciudades = (Ciudades ?? Enumerable.Empty<CatalogoDetalleModelo>()).Concat(new[] { resp.Data });
            SelectedId = resp.Data.Id;
            await SelectedIdChanged.InvokeAsync(SelectedId);
            CloseDialog();
        }
    }
}
