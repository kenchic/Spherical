@using MudBlazor
@using Spherical.Client.Services
@using Spherical.Client.DTO.Common
@namespace Spherical.Blazor.Components

<MudStack Row Spacing="1">
    <MudSelect T="string" Label="Unidad de Medida" @bind-Value="SelectedId" Required="true">
        @if (Unidades != null)
        {
            foreach (var u in Unidades)
            {
                <MudSelectItem Value="@u.Id">@u.Nombre</MudSelectItem>
            }
        }
    </MudSelect>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenDialog" />
</MudStack>

<MudDialog @bind-IsVisible="DialogOpen">
    <DialogContent>
        <MudTextField @bind-Value="NuevaUnidadNombre" Label="Nombre unidad" />
        <MudTextField @bind-Value="NuevaUnidadId" Label="Código" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CrearUnidad" Disabled="Loading" Loading="Loading">Crear</MudButton>
        <MudButton OnClick="CloseDialog">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string IdCatalogo { get; set; } = "UN_ELEMENTO";
    [Parameter] public string SelectedId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }
    [Parameter] public EventCallback<CatalogoDetalleModelo> OnCreated { get; set; }

    [Inject] public ICatalogService CatalogService { get; set; } = default!;

    private IEnumerable<CatalogoDetalleModelo>? Unidades;
    private bool DialogOpen;
    private string NuevaUnidadNombre = string.Empty;
    private string NuevaUnidadId = string.Empty;
    private bool Loading;

    protected override async Task OnInitializedAsync()
    {
        var resp = await CatalogService.GetDetallesAsync(IdCatalogo);
        Unidades = resp.Data ?? Enumerable.Empty<CatalogoDetalleModelo>();
        if (string.IsNullOrEmpty(SelectedId) && Unidades.Any())
            SelectedId = Unidades.First().Id;
    }

    private void OpenDialog() => DialogOpen = true;
    private void CloseDialog() => DialogOpen = false;

    private async Task CrearUnidad()
    {
        Loading = true;
        var nuevo = new CatalogoDetalleModelo { Id = NuevaUnidadId.Trim(), Nombre = NuevaUnidadNombre.Trim(), Activo = true };
        var resp = await CatalogService.CreateDetalleAsync(IdCatalogo, nuevo);
        Loading = false;
        if (resp.Success && resp.Data != null)
        {
            await OnCreated.InvokeAsync(resp.Data);
            Unidades = (Unidades ?? Enumerable.Empty<CatalogoDetalleModelo>()).Concat(new[] { resp.Data });
            SelectedId = resp.Data.Id;
            await SelectedIdChanged.InvokeAsync(SelectedId);
            CloseDialog();
        }
    }
}
