@using Spherical.Client.DTO.Lineup
@using Spherical.Client.Services
@using System.Globalization
@inject IElementoService ElementoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-3" />
                    <MudText Typo="Typo.h5">Gestión de Elementos</MudText>                    
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Administre los elementos de su empresa, incluyendo información básica y listas de precios
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalCrear">
                    Nuevo
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="CargarElementos"
                           Class="ml-2">
                    Actualizar
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (IsLoading)
            {
                <div class="d-flex justify-center align-center" style="height: 200px;">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                </div>
            }
            else
            {
                <MudGrid Class="mb-4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="searchString" 
                                      Placeholder="Buscar por referencia, nombre o ID..." 
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      DebounceInterval="300"
                                      Clearable="true"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect @bind-Value="filtroRotacion" 
                                   Placeholder="Rotación"
                                   Clearable="true"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Sync">
                            <MudSelectItem Value="@((bool?)true)">Sí</MudSelectItem>
                            <MudSelectItem Value="@((bool?)false)">No</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect @bind-Value="filtroActivo" 
                                   Placeholder="Estado"
                                   Clearable="true"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Flag">
                            <MudSelectItem Value="@((bool?)true)">Activo</MudSelectItem>
                            <MudSelectItem Value="@((bool?)false)">Inactivo</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDataGrid T="ElementoDTO"
                             Items="@ElementosFiltrados"
                             SortMode="SortMode.Multiple"
                             Groupable="false"
                             Pageable="true"
                             PageSize="10"
                             RowsPerPageString="Filas por página"
                             InfoFormat="{first_item}-{last_item} de {all_items}"
                             PaginationClass="my-custom-class"
                             Hover="true"
                             Dense="true"
                             Striped="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
                        <PropertyColumn Property="x => x.Referencia" Title="Referencia" Sortable="true" />
                        <PropertyColumn Property="x => x.Nombre" Title="Nombre" Sortable="true" />
                        <PropertyColumn Property="x => x.Mt2" Title="M²" Sortable="true">
                            <CellTemplate>
                                @context.Item.Mt2.ToString("N2", CultureInfo.CurrentCulture)
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Peso" Title="Peso (Kg)" Sortable="true">
                            <CellTemplate>
                                @context.Item.Peso.ToString("N2", CultureInfo.CurrentCulture)
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Rotacion" Title="Rotación" Sortable="true">
                            <CellTemplate>
                                <MudChip T="string"
                                         Color="@( @context.Item.Rotacion ? Color.Success : Color.Default)"
                                         Size="Size.Small">
                                    @( @context.Item.Rotacion ? "Si" : "No")
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Activo" Title="Estado" Sortable="true">
                            <CellTemplate>
                                <MudChip T="string" 
                                         Color="@(context.Item.Activo ? Color.Success : Color.Default)" 
                                         Size="Size.Small">
                                    @(context.Item.Activo ? "Activo" : "Inactivo")
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Title="Acciones" Sortable="false">
                            <CellTemplate>
                                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => AbrirModalEditar(context.Item))"
                                                   Title="Editar" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => EliminarElemento(context.Item))"
                                                   Title="Desactivar" />
                                </MudButtonGroup>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ElementoDTO" PageSizeOptions=@(new int[] { 5, 10, 15, 20 }) />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<ElementoDTO> Elementos = new();
    private List<ElementoDTO> ElementosFiltrados => FiltrarElementos();
    private bool IsLoading = true;
    private string searchString = string.Empty;
    private bool? filtroRotacion = null;
    private bool? filtroActivo = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarElementos();
    }

    private List<ElementoDTO> FiltrarElementos()
    {
        var elementosFiltrados = Elementos.AsEnumerable();

        // Filtro por texto de búsqueda
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var searchTerm = searchString.ToLowerInvariant();
            elementosFiltrados = elementosFiltrados.Where(x => 
                x.Id.ToString().Contains(searchTerm) ||
                x.Referencia?.ToLowerInvariant().Contains(searchTerm) == true ||
                x.Nombre?.ToLowerInvariant().Contains(searchTerm) == true
            );
        }

        // Filtro por Rotación
        if (filtroRotacion.HasValue)
        {
            elementosFiltrados = elementosFiltrados.Where(x => x.Rotacion == filtroRotacion.Value);
        }

        // Filtro por Estado
        if (filtroActivo.HasValue)
        {
            elementosFiltrados = elementosFiltrados.Where(x => x.Activo == filtroActivo.Value);
        }

        return elementosFiltrados.ToList();
    }

    private async Task CargarElementos()
    {
        IsLoading = true;
        filtroActivo = true;
        StateHasChanged();

        try
        {
            var response = await ElementoService.GetElementosAsync();
            if (response.Success && response.Data != null)
            {
                Elementos = response.Data.ToList();
            }
            else
            {
                Snackbar.Add(response.ErrorMessage ?? "Error al cargar elementos", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task AbrirModalCrear()
    {
        var parameters = new DialogParameters<SphElementoModal>
        {
            { x => x.Elemento, new ElementoDTO() },
            { x => x.EsNuevo, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<SphElementoModal>("Crear Elemento", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await CargarElementos();
        }
    }

    private async Task AbrirModalEditar(ElementoDTO elemento)
    {
        var elementoCopia = new ElementoDTO
        {
            Id = elemento.Id,
            IdGrupoElemento = elemento.IdGrupoElemento,
            IdUnidadMedida = elemento.IdUnidadMedida,
            Referencia = elemento.Referencia,
            Empresa = elemento.Empresa,
            Nombre = elemento.Nombre,
            Mt2 = elemento.Mt2,
            Peso = elemento.Peso,
            Rotacion = elemento.Rotacion,
            Activo = elemento.Activo
        };

        var parameters = new DialogParameters<SphElementoModal>
        {
            { x => x.Elemento, elementoCopia },
            { x => x.EsNuevo, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<SphElementoModal>("Editar Elemento", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await CargarElementos();
        }
    }

    private async Task EliminarElemento(ElementoDTO elemento)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {            
            { x => x.Message, $"¿Está seguro que desea desactivar el elemento '{elemento.Nombre}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Desactivar" },
            { x => x.CancelText, "Cancelar" }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = false,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Eliminar", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                var response = await ElementoService.DeleteElementoAsync(elemento.Id);
                if (response.Success)
                {
                    Snackbar.Add("Elemento eliminado exitosamente", Severity.Success);
                    await CargarElementos();
                }
                else
                {
                    Snackbar.Add(response.ErrorMessage ?? "Error al eliminar elemento", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
            }
        }
    }
}