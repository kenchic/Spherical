@using Creative.Modelos.Lineup
@using Spherical.Client.DTO.Spherical
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4" Gutters="false">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-3" />
                    <MudText Typo="Typo.h5">Gestión de Proyectos</MudText>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Administra los proyectos de tu empresa, incluyendo información básica
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButtonGroup Variant="Variant.Filled" Size="Size.Small" OverrideStyles="false">
                    @if (Permisos.Crear)
                    {
                        <MudIconButton Color="Color.Primary"
                                       Title="Nuevo"
                                       Icon="@Icons.Material.Filled.Add"
                                       OnClick="AbrirModalCrear">
                        </MudIconButton>
                        <MudIconButton Color="Color.Primary"
                                       Title="Cargue masivo"
                                       Icon="@Icons.Material.Filled.Upload">
                        </MudIconButton>
                    }
                    @if (Permisos.Consultar)
                    {
                        <MudIconButton Color="Color.Secondary"
                                       Title="Actualizar"
                                       Icon="@Icons.Material.Filled.Refresh"
                                       OnClick="CargarProyectos">
                        </MudIconButton>
                        <MudIconButton Color="Color.Info"
                                       Title="Exportar a Excel"
                                       Icon="@Icons.Material.Filled.Download">
                        </MudIconButton>
                    }
                </MudButtonGroup>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (_isLoading)
            {
                <div class="d-flex justify-center align-center" style="height: 200px;">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                </div>
            }
            else
            {
                @if (!Permisos.Consultar)
                {
                    <MudAlert Severity="Severity.Warning" Elevation="0">
                        No tiene permiso para consultar esta opción.
                    </MudAlert>
                }
                else
                {
                    @if (_errorMessage is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
                    }

                    <MudDataGrid T="VProyectoModeloDto" Items="_proyectos"
                                 Filterable="true" FilterMode="DataGridFilterMode.Simple"
                                 Sortable="true" Pageable="true" PageSize="15"
                                 Dense="true" Hover="true" Striped="true" Bordered="false"
                                 SortMode="SortMode.Multiple"
                                 QuickFilter="@_quickFilter">
                        <ToolBarContent>
                            <MudTextField @bind-Value="_searchString"
                                          Placeholder="Buscar..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Immediate="true"
                                          Class="mt-0" />
                        </ToolBarContent>
                        <Columns>
                            <PropertyColumn Property="x => x.Id"          Title="ID"        Sortable="true" Filterable="false" />
                            <PropertyColumn Property="x => x.NombreProyecto" Title="Proyecto"  Sortable="true" />
                            <PropertyColumn Property="x => x.NombreCliente"  Title="Cliente"   Sortable="true" />
                            <PropertyColumn Property="x => x.NombreCiudad"   Title="Ciudad"    Sortable="true" />
                            <PropertyColumn Property="x => x.Tipo"           Title="Tipo"      Sortable="true" />
                            <PropertyColumn Property="x => x.NombreEstado"   Title="Estado"    Sortable="true" />
                            <PropertyColumn Property="x => x.Fecha"          Title="Fecha"     Sortable="true" Format="dd/MM/yyyy" />
                            <TemplateColumn Title="Activo" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    <MudIcon Icon="@(context.Item.Activo == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                             Color="@(context.Item.Activo == true ? Color.Success : Color.Error)"
                                             Size="Size.Small" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="VProyectoModeloDto" />
                        </PagerContent>
                    </MudDataGrid>
                }
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

<MudDialog @bind-Visible="_visible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Crear
        </MudText>
    </TitleContent>
    <DialogContent>
        <SphFormularioProyecto />
    </DialogContent>
</MudDialog>


@inject IProjectService ProjectService

@code {
    private PermisoUsuarioDto Permisos = new() { Activar = true, Consultar = true, Crear = true, Eliminar = true, Editar = true };
    private bool _isLoading = false;
    private bool _visible = false;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private IEnumerable<VProyectoModeloDto> _proyectos = [];
    private string? _errorMessage;
    private string _searchString = string.Empty;
    private Func<VProyectoModeloDto, bool> _quickFilter => p =>
        string.IsNullOrWhiteSpace(_searchString)
        || p.NombreProyecto?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
        || p.NombreCliente?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
        || p.NombreCiudad?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
        || p.Tipo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true
        || p.NombreEstado?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectos();
    }

    private async Task CargarProyectos()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await ProjectService.GetProyectosAsync();
            if (result.Success)
                _proyectos = result.Data ?? [];
            else
                _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AbrirModalCrear()
    {
        _visible = true;
    }
}
