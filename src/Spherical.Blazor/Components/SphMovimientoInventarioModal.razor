@using Microsoft.AspNetCore.Components.Forms
@using Spherical.Client.DTO.Inventory
@using Spherical.Client.DTO.Lineup
@using System.Security.Claims
@using MudBlazor
@using Spherical.Client.DTO.Spherical
@using Microsoft.JSInterop
@using System.Xml.Linq
@using Spherical.Core.Creative
@using System.Collections.Generic

@inject IDocumentoService DocumentoService
@inject IElementoService ElementoService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IBodegaService BodegaService
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav

<MudDialog>
    <DialogContent>
        <!-- Prevención: bloquear que Enter dispare el submit en cualquier campo (excepto textarea) -->
        <EditForm Model="@Documento" OnValidSubmit="GuardarMovimiento" OnInvalidSubmit="OnInvalidSubmit">
            <DataAnnotationsValidator />
            <MudCard>
                <MudCardContent>
                    <MudPaper Class="pa-4">
                        <MudGrid Class="mb-3">
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="string" @bind-Value="Documento.IdDocumentoTipo"
                                           Label="Tipo de Documento"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           For="@(() => Documento.IdDocumentoTipo)"
                                           HelperText="Seleccione el tipo de documento"
                                           Required="true"
                                           RequiredError="Este campo es requerido"
                                           Disabled=@(!EsNuevo)>
                                    @if (Tipos != null)
                                    {
                                        foreach (var t in Tipos)
                                        {
                                            <MudSelectItem Value="@t.Id">@t.Nombre (@t.Operacion)</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="2" md="2" Class="d-flex align-center">
                                <MudChip T="string" Color="@OperacionColor" Variant="Variant.Filled">Operación: @OperacionTexto</MudChip>
                            </MudItem>

                            <!-- Espacio vacío -->
                            <MudItem xs="12" sm="12" md="4">
                                <!-- vacío a propósito -->
                            </MudItem>

                            <MudItem xs="12" sm="12" md="2">
                                <MudTextField T="string" Label="Numero"
                                              Value="@ConsecutivoTexto.ToString()"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" ReadOnly="true"
                                              Disabled="true" />
                            </MudItem>

                            <MudItem xs="12" sm="3" md="4">
                                <MudSelect T="int" @bind-Value="Documento.IdBodegaOrigen"
                                           Label="Bodega Origen"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           For="@(() => Documento.IdBodegaOrigen)"
                                           HelperText="Seleccione la bodega origen"
                                           Required="true">
                                    @if (Bodegas != null)
                                    {
                                        foreach (var b in Bodegas)
                                        {
                                            <MudSelectItem Value="@b.Id">@(b.Nombre ?? b.Codigo)</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="3" md="4">
                                <MudSelect T="int" @bind-Value="Documento.IdBodegaDestino"
                                           Label="Bodega Destino"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           For="@(() => Documento.IdBodegaDestino)"
                                           HelperText="Seleccione la bodega destino"
                                           Required="true">
                                    @if (Bodegas != null)
                                    {
                                        foreach (var b in Bodegas)
                                        {
                                            <MudSelectItem Value="@b.Id">@(b.Nombre ?? b.Codigo)</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="4" md="4">
                                <MudDatePicker Label="Fecha"
                                               @bind-Date="fecha"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" sm="12" md="12">
                                <MudTextField @bind-Value="Documento.Descripcion"
                                              Label="Observación"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true" />
                            </MudItem>

                        </MudGrid>

                        <MudTable Items="Detalles" Dense="true" Hover="true" Class="mb-2">
                            <HeaderContent>
                                <MudTh>Elemento</MudTh>
                                <MudTh style="width:120px">Cantidad</MudTh>
                                <MudTh style="width:60px"></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="rowContext">
                                <MudTd>
                                    <MudAutocomplete T="ElementoDto"
                                                     @bind-Value="rowContext.ItemElemento"
                                                     Dense="true"
                                                     Margin="Margin.Dense"
                                                     Clearable="true"
                                                     Variant="Variant.Outlined"
                                                     ResetValueOnEmptyText="true"
                                                     ToStringFunc="@(e => e == null ? string.Empty : $"{e.Referencia} - {e.Nombre}")"
                                                     SearchFunc="BuscarElementos"
                                                     MaxItems="8" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="int"
                                                     @bind-Value="rowContext.Cantidad"
                                                     Min="0"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.CleaningServices" Color="Color.Error" OnClick="(() => QuitarFila(rowContext))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AgregarFila">Agregar fila</MudButton>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarMovimiento" Disabled="@(string.IsNullOrWhiteSpace(selectedTipoId) || Detalles.Count == 0)">Guardar</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end" Style="gap: 12px;">
                    <MudTextField T="string" Label="Nombre archivo a imprimir"
                                  @bind-Value="NombreArchivoExcel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="max-width: 280px" />
                    <MudButton Color="Color.Info"
                               Variant="Variant.Outlined"
                               Disabled="@IsExportando"
                               OnClick="ExportarExcel">
                        @if (IsExportando)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Imprimiendo...</MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Print" />
                            <MudText Class="ms-2">Imprimir</MudText>
                        }
                    </MudButton>
                    @if (!SoloLectura)
                    {
                        <MudButton Color="Color.Primary"
                        Variant="Variant.Filled"
                        ButtonType="ButtonType.Submit"
                        Disabled="@IsGuardando">
                            @if (IsGuardando)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Guardando...</MudText>
                            }
                            else
                            {
                                @(EsNuevo ? "Crear" : "Actualizar")
                            }
                        </MudButton>
                    }
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">Cancelar</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool EsNuevo { get; set; } = true;
    [Parameter] public DocumentoDto Documento { get; set; } = new() { Fecha = DateTime.Today };
    [Parameter] public bool SoloLectura { get; set; } = true;

    private List<DocumentoTipoDto> Tipos = new();
    private string? selectedTipoId;
    private DateTime? fecha = DateTime.Today;
    private string? descripcion;
    private bool IsGuardando = false;
    private bool IsExportando = false;
    private string NombreArchivoExcel = string.Empty;

    private List<FilaDetalle> Detalles = new();

    // Estado de operación según tipo seleccionado
    private string OperacionTexto => Tipos.FirstOrDefault(t => t.Id == Documento.IdDocumentoTipo)?.Operacion == "-" ? "Salida (-)" : "Entrada (+)";
    private Color OperacionColor => Tipos.FirstOrDefault(t => t.Id == Documento.IdDocumentoTipo)?.Operacion == "-" ? Color.Error : Color.Success;
    private int ConsecutivoTexto => EsNuevo ? Tipos.FirstOrDefault(t => t.Id == Documento.IdDocumentoTipo)?.Consecutivo ?? 0 : Documento.Numero;

    private void Cancel() => MudDialog.Cancel();
    private List<BodegaDto> Bodegas = new();
    
    private IJSObjectReference? _preventEnterModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = (AuthStateProvider as CustomAuthStateProvider)?.GetToken();
            DocumentoService.SetAuth(token);
            ElementoService.SetAuth(token);
            BodegaService.SetAuth(token);

            await CargarTipos();
            await CargarBodegas();

            if (!EsNuevo && Documento.Id > 0)
            {
                await CargarDocumento(Documento.Id);
                NombreArchivoExcel = $"MovimientoInventario_{ConsecutivoTexto}.xlsx";
            }
            else
            {
                Documento.Id = 0;
                Documento.IdBodegaOrigen = 0;
                Documento.IdBodegaDestino = 1;

                // Obtener usuario y claims
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;

                // Extraer name y locale desde los claims (con fallback)
                var locale = GetClaim(user, "locale", ClaimTypes.Locality, "ui_locale") ?? "AYZCORP";
                Documento.Empresa = locale;

                for (int i = 0; i < 10; i++)
                {
                    Detalles.Add(new FilaDetalle());
                }
                NombreArchivoExcel = $"MovimientoInventario_{ConsecutivoTexto}.xlsx";
            }            
        }
    }

    private async Task CargarTipos()
    {
        var resp = await DocumentoService.GetTiposAsync();
        if (resp.Success && resp.Data != null)
        {
            Tipos = resp.Data.ToList();
        }
        else
        {
            Snackbar.Add(resp.ErrorMessage ?? "No fue posible cargar los tipos de documento", Severity.Error);
        }
    }

    private void AgregarFila()
    {
        Detalles.Add(new FilaDetalle());
    }

    private void QuitarFila(FilaDetalle fila)
    {
        if (fila is null) return;
        fila.ItemElemento = null;
        fila.IdElemento = 0;
        fila.ElementoNombre = null;
        fila.Cantidad = 0;
        StateHasChanged();
    }

    private async Task<IEnumerable<ElementoDto>> BuscarElementos(string value, CancellationToken token)
    {
        await Task.Delay(5, token);

        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<ElementoDto>();

        var result = await ElementoService.GetElementosAsync();
        var listado = result.Success && result.Data != null ? result.Data : Enumerable.Empty<ElementoDto>();
        return listado.Where(e => ($"{e.Referencia} - {e.Nombre}").Contains(value, StringComparison.InvariantCultureIgnoreCase)).Take(8);
    }

    private async Task GuardarMovimiento()
    {
        IsGuardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(Documento.IdDocumentoTipo))
            {
                Snackbar.Add("Seleccione el tipo de documento", Severity.Warning);
                return;
            }
            var detallesValidos = Detalles.Where(d => d.ItemElemento is not null && d.ItemElemento.Id > 0 && d.Cantidad > 0)
                                          .Select(d => new DocumentoDetalleDto { IdElemento = (short)d.ItemElemento.Id, Cantidad = d.Cantidad })
                                          .ToList();
            if (detallesValidos.Count == 0)
            {
                Snackbar.Add("Agregue al menos un elemento con cantidad", Severity.Warning);
                return;
            }

            // Sincronizar la fecha del documento desde el campo local nullable
            Documento.Fecha = fecha ?? DateTime.Today;
            Documento.Numero = ConsecutivoTexto;
            Documento.Detalles = detallesValidos;

            ApiResponse<bool> resp;
                    
            if (EsNuevo)
            {
                resp = await DocumentoService.CrearDocumentoAsync(Documento);
                if (resp.Success)
                {
                    Snackbar.Add($"Documento creado Nº {ConsecutivoTexto}", Severity.Success);
                    MudDialog?.Close(DialogResult.Ok(true));
                }
            }
            else
            {
                resp = await DocumentoService.ActualizarDocumentoAsync(Documento.Id, Documento);
                if (resp.Success)
                {
                    Snackbar.Add($"Documento actualizado Nº {ConsecutivoTexto}", Severity.Success);
                    MudDialog?.Close(DialogResult.Ok(true));
                }
            }

            if (!resp.Success)
                Snackbar.Add(resp.ErrorMessage ?? "No fue posible guardar el documento", Severity.Error);

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsGuardando = false;
            StateHasChanged();
        }
    }

    private async Task ExportarExcel()
    {
        IsExportando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(NombreArchivoExcel))
            {
                Snackbar.Add("Ingrese un nombre de archivo", Severity.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(Documento.IdDocumentoTipo))
            {
                Snackbar.Add("Seleccione el tipo de documento", Severity.Warning);
                return;
            }

            var detallesValidos = Detalles.Where(d => d.ItemElemento is not null && d.ItemElemento.Id > 0 && d.Cantidad > 0).ToList();
            if (detallesValidos.Count == 0)
            {
                Snackbar.Add("Agregue al menos un elemento con cantidad", Severity.Warning);
                return;
            }

            Documento.Fecha = fecha ?? DateTime.Today;
            Documento.Numero = ConsecutivoTexto;

            byte[]? plantilla = await TryCargarPlantillaAsync("plantillas/MovimientoInventario.xlsx");
            if (plantilla is null || plantilla.Length == 0)
            {
                Snackbar.Add("La plantilla no se encontró o está vacía", Severity.Error);
                return;
            }

            var exporter = new ExcelPlantillaExporter();
            var detallesExcel = detallesValidos.Select(d => new ExcelPlantillaExporter.ModeloMovimientoDetalle(
                $"{d.ItemElemento.Referencia} - {d.ItemElemento.Nombre}",
                d.Cantidad
            ));

            byte[] archivo;
            try
            {
                var encabezados = new Dictionary<string, object>
                {
                    ["K2"] = Documento.Numero,
                    ["D4"] = OperacionTexto ?? string.Empty,
                    ["K4"] = Documento.Fecha.ToShortDateString(),
                    ["B28"] = Documento.Descripcion ?? string.Empty
                };
                archivo = exporter.Export(plantilla, encabezados, detallesExcel);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al preparar XLSX: {ex.Message}", Severity.Error);
                return;
            }

            var nombre = NombreArchivoExcel.EndsWith(".xlsx", StringComparison.InvariantCultureIgnoreCase) ? NombreArchivoExcel : NombreArchivoExcel + ".xlsx";
            await JS.InvokeVoidAsync("downloadFile", nombre, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", archivo);
            
            Snackbar.Add($"Descarga iniciada: {nombre}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No fue posible exportar: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsExportando = false;
            StateHasChanged();
        }
    }

    private async Task<byte[]?> TryCargarPlantillaAsync(string ruta)
    {
        try
        {
            var abs = Nav.ToAbsoluteUri(ruta.StartsWith("/") ? ruta : "/" + ruta);
            var resp = await Http.GetAsync(abs);
            if (resp.IsSuccessStatusCode)
            {
                return await resp.Content.ReadAsByteArrayAsync();
            }
            return null;
        }
        catch { return null; }
    }

    private class FilaDetalle
    {
        public int IdElemento { get; set; }
        public int Cantidad { get; set; } = 0;
        public string? ElementoNombre { get; set; }
        public ElementoDto ItemElemento { get; set; } = null!;
    }

    private async Task CargarDocumento(int id)
    {
        try
        {


            var resp = await DocumentoService.GetDocumentoAsync(id);
            if (resp.Success && resp.Data != null)
            {
                Documento.Id = id;
                Documento.IdDocumentoTipo = resp.Data.IdDocumentoTipo;
                selectedTipoId = resp.Data.IdDocumentoTipo;
                Documento.IdBodegaOrigen = resp.Data.IdBodegaOrigen;
                Documento.IdBodegaDestino = resp.Data.IdBodegaDestino;
                Documento.Fecha = resp.Data.Fecha;
                fecha = resp.Data.Fecha; // Reflejar en el picker local
                Documento.Descripcion = resp.Data.Descripcion;
                Documento.Empresa = resp.Data.Empresa;
                Documento.Numero = resp.Data.Numero;

                var elementosResp = await ElementoService.GetElementosAsync();
                var elementos = elementosResp.Success && elementosResp.Data != null ? elementosResp.Data.ToList() : new List<ElementoDto>();

                Detalles = resp.Data.Detalles.Select(d =>
                {
                    var item = elementos.FirstOrDefault(e => e.Id == d.IdElemento);
                    return new FilaDetalle
                    {
                        IdElemento = d.IdElemento,
                        ElementoNombre = d.ElementoNombre,
                        Cantidad = d.Cantidad,
                        ItemElemento = item ?? new ElementoDto
                        {
                            Id = (short)d.IdElemento,
                            Nombre = d.ElementoNombre ?? string.Empty,
                            Referencia = d.ElementoNombre ?? string.Empty,
                            Empresa = resp.Data.Empresa,
                            IdGrupoElemento = "-",
                            IdUnidadMedida = "-"
                        }
                    };
                }).ToList();
                StateHasChanged();
            }
            else if (!string.IsNullOrWhiteSpace(resp.ErrorMessage))
            {
                Snackbar.Add(resp.ErrorMessage!, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar documento: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarBodegas()
    {
        var resp = await BodegaService.GetBodegasAsync();
        if (resp.Success && resp.Data != null)
        {
            Bodegas = resp.Data.ToList();
        }
        else
        {
            Snackbar.Add(resp.ErrorMessage ?? "No fue posible cargar las bodegas", Severity.Error);
        }
    }

    private string? GetClaim(ClaimsPrincipal user, params string[] types)
    {
        foreach (var type in types)
        {
            var claim = user.FindFirst(type);
            if (claim != null && !string.IsNullOrEmpty(claim.Value))
                return claim.Value;
        }
        return null;
    }

    private void OnInvalidSubmit(EditContext editContext)
    {
        Snackbar.Add("Por favor, completa los campos requeridos antes de continuar.", Severity.Warning);
    }
}
